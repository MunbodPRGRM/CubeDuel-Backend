# --- server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# ปลายทางเว็บ — ใช้ตอน redirect กลับจาก OAuth และลิงก์รีเซ็ตรหัสผ่าน (ไม่ใส่ = ใช้ค่า CORS_ORIGIN)
FRONTEND_URL=http://localhost:5173

# --- database ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/cubeduel?schema=public"

# --- auth (เฟส 2) ---
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
# ตั้ง true เฉพาะตอน dev เวลายิงทดสอบรัว ๆ แล้วไม่อยากโดน rate limit ของตัวเอง
DISABLE_RATE_LIMIT=false

# --- OAuth (เฟส 2) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
