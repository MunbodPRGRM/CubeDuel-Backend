# --- server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# ปลายทางเว็บ — ใช้ตอน redirect กลับจาก OAuth และลิงก์รีเซ็ตรหัสผ่าน (ไม่ใส่ = ใช้ค่า CORS_ORIGIN)
FRONTEND_URL=http://localhost:5173

# --- database ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/cubeduel?schema=public"

# --- auth (เฟส 2) ---
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
# ตั้ง true เฉพาะตอน dev เวลายิงทดสอบรัว ๆ แล้วไม่อยากโดน rate limit ของตัวเอง
DISABLE_RATE_LIMIT=false

# --- อีเมล (ADR-056 · แก้โดย ADR-067 · ADR-068) ---
# ⚠️ ตอนนี้ไม่มีโค้ดส่วนไหนส่งอีเมล — หน้าลืมรหัสผ่านถูกตัดไปแล้ว (ADR-068) · ทั้งบล็อกนี้เก็บไว้เผื่ออนาคต
# console = พิมพ์อีเมลลง log ของ server แทนการส่งจริง — **ค่าเริ่มต้นทุกที่ รวม production**
# smtp    = ส่งจริง · ตั้งเป็น smtp เมื่อไหร่ SMTP_HOST/USER/PASS ถึงกลายเป็นของบังคับ ไม่ครบ = server ไม่สตาร์ต
EMAIL_TRANSPORT=console
# ทั้งบล็อกข้างล่างไม่ต้องใส่ถ้า EMAIL_TRANSPORT=console (เครื่องที่ deploy อยู่ตอนนี้ไม่ได้ใส่เลยสักตัว)
# Gmail: เปิด 2-Step Verification ของบัญชีก่อน แล้วสร้าง App Password (16 ตัว) มาใส่ SMTP_PASS
# ห้ามใช้รหัสผ่านจริงของบัญชี · ควรเป็นบัญชี Gmail ที่สมัครไว้ให้โปรเจกต์โดยเฉพาะ
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# ชื่อผู้ส่งที่ผู้รับเห็น (ไม่ใส่ = "CubeDuel <SMTP_USER>") — Gmail บังคับที่อยู่ให้เป็นบัญชีที่ล็อกอินอยู่ดี
MAIL_FROM=

# --- ทดสอบ (เฟส 5 ก้อนที่ 1) ---
# ตั้ง 1 เพื่อให้ room:create สร้างห้อง kind: 'competitive' ได้ ใช้ตอนรัน npm run smoke:rated
# ก่อนคิวจับคู่จริงจะเสร็จ (ADR-038) — production ปิดตายเสมอไม่ว่าค่านี้จะเป็นอะไร
ALLOW_TEST_COMPETITIVE_ROOM=0

# --- ทดสอบ (เฟส 12 ก้อนที่ 3 — ADR-060) · ⚠️ ถอดออกก่อน deploy ---
# ตั้ง true เพื่อให้ห้องแข่งมีปุ่ม "เสร็จทันที" (solve:dev_finish) — server ตัดสินว่าแก้เสร็จโดยไม่ replay
# ห้องที่ปรับคะแนนจะปรับ Elo ใน DB จริง
# ⚠️ ตั้งแต่ ADR-060 ข้อ 7 ค่านี้ **เปิดบน production ได้** (เดิมปิดตาย) — เปิดไว้ตอนทดสอบ deploy เท่านั้น
# ไม่ตั้ง/ตั้งเป็นอย่างอื่น = ปิด · ใครเผลอตั้ง true บนเครื่องที่ผู้ใช้จริงใช้อยู่ = โกงได้ทันที
DEV_INSTANT_FINISH=false

# --- งานเบื้องหลัง (เฟส 10 ก้อนที่ 1) ---
# ตั้ง true เพื่อปิดตัวจับเวลาของ src/jobs/ ทั้งหมด — ใช้ตอนรัน npm run smoke:jobs
DISABLE_MAINTENANCE_JOBS=false

# --- เข้าสู่ระบบด้วย Google (เฟส 2 — ADR-058) · ไม่มี Facebook แล้ว ---
# เว้นว่าง = ปิดฟีเจอร์ (ปุ่มยังอยู่ กดแล้วกลับมาพร้อมข้อความว่ายังไม่เปิดให้ใช้) · server ยังสตาร์ตได้ปกติ
# วิธีสร้าง client: docs/decisions.md ADR-058 ข้อ 9 — ประเภท "Web application"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ต้องตรงกับ Authorized redirect URI ใน Google Cloud Console ทุกตัวอักษร (ไม่ใส่ = ค่านี้ ตาม PORT)
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/oauth/google/callback
