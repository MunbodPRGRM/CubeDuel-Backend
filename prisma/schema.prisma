// CubeDuel — Prisma schema
// แหล่งความจริง: docs/database-schema.md (12 ตาราง)
// ⚠️ CHECK constraint ของ MatchFlag / Report เขียนใน schema ไม่ได้ — อยู่ใน migration เป็น raw SQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- enum (ประกาศครั้งเดียว ใช้ซ้ำทุกตาราง ห้ามประกาศซ้ำ) ----------

enum CubeType {
  CUBE_2X2X2  @map("2x2x2")
  CUBE_3X3X3  @map("3x3x3")
  PYRAMINX    @map("pyraminx")
  PYRAMORPHIX @map("pyramorphix")
}

enum UserRole {
  MEMBER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum RoomType {
  COMPETITIVE
  CUSTOM
}

enum RoomMode {
  AUTO
  CUSTOM
}

enum SolveResult {
  SOLVED
  DNF
  SURRENDERED
}

enum OAuthProvider {
  GOOGLE
  FACEBOOK
}

enum ReportStatus {
  PENDING
  RESOLVED
}

enum ReportAction {
  NONE
  WARNING
  SUSPENDED
  RATING_RESET
}

enum FlagReason {
  IMPOSSIBLE_TIME
  LOW_MOVE_COUNT
  HIGH_TPS
  MOVE_GAP
  WIN_STREAK
}

enum FlagVerdict {
  CLEAN
  CHEATING
  INCONCLUSIVE
}

// ============================================================
//  กลุ่มผู้ใช้ + auth
// ============================================================

/// ผู้ใช้ — ไม่มีคอลัมน์ elo_rating (อยู่ในตาราง Rating 4 แถวต่อคน)
model User {
  userId         Int        @id @default(autoincrement()) @map("user_id")
  username       String     @unique @db.VarChar(50)
  email          String     @unique @db.VarChar(100)
  /// NULL ได้ — ผู้ใช้ OAuth ไม่มีรหัสผ่าน (ตอน login ต้องตอบว่า "บัญชีนี้ใช้ Google/Facebook")
  passwordHash   String?    @map("password_hash") @db.VarChar(255)
  nickname       String?    @db.VarChar(50)
  role           UserRole   @default(MEMBER)
  status         UserStatus @default(ACTIVE)
  cubeSkin       String     @default("classic") @map("cube_skin") @db.VarChar(30)
  /// status = SUSPENDED + suspended_until = NULL คือระงับถาวร, มีค่า = ระงับชั่วคราวถึงเวลานั้น
  suspendedUntil DateTime?  @map("suspended_until")
  /// ผู้ใช้ลบบัญชีเอง (soft delete, ADR-008) — query สาธารณะต้องกรอง deleted_at IS NULL
  deletedAt      DateTime?  @map("deleted_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  oauthAccounts       OAuthAccount[]
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]
  ratings             Rating[]
  matchesAsPlayer1    Match[]                       @relation("MatchPlayer1")
  matchesAsPlayer2    Match[]                       @relation("MatchPlayer2")
  matchesWon          Match[]                       @relation("MatchWinner")
  multiplayerEntries  MultiplayerMatchParticipant[]
  reportsFiled        Report[]                      @relation("ReportReporter")
  reportsAgainst      Report[]                      @relation("ReportReported")
  reportsReviewed     Report[]                      @relation("ReportReviewer")
  news                News[]
  flags               MatchFlag[]                   @relation("MatchFlagUser")
  flagsReviewed       MatchFlag[]                   @relation("MatchFlagReviewer")
  auditLogsMade       AdminAuditLog[]               @relation("AuditAdmin")
  auditLogsAbout      AdminAuditLog[]               @relation("AuditTarget")

  @@index([deletedAt])
}

/// ➕ ผูกบัญชี Google/Facebook — แยกตารางเพื่อให้ผูกได้ทั้งสอง provider พร้อมกัน
model OAuthAccount {
  oauthAccountId Int           @id @default(autoincrement()) @map("oauth_account_id")
  userId         Int           @map("user_id")
  provider       OAuthProvider
  providerUserId String        @map("provider_user_id") @db.VarChar(255)
  createdAt      DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  /// บัญชีฝั่ง provider หนึ่งบัญชีผูกกับผู้ใช้ในระบบได้คนเดียว
  @@unique([provider, providerUserId])
  /// ผู้ใช้หนึ่งคนผูก provider เดิมซ้ำไม่ได้ (แต่ผูกทั้ง Google และ Facebook พร้อมกันได้)
  @@unique([userId, provider])
}

/// ➕ token รีเซ็ตรหัสผ่าน — เก็บ SHA-256 ไม่เก็บ token ดิบ, อายุ 30 นาที, ใช้ได้ครั้งเดียว
model PasswordResetToken {
  tokenId   Int       @id @default(autoincrement()) @map("token_id")
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  /// ขอ token ใหม่ → เพิกถอน token เก่าที่ยังไม่ใช้ของผู้ใช้คนนั้นทั้งหมด
  @@index([userId, usedAt])
}

/// ➕ refresh token ที่เพิกถอนได้ (30 วัน) + rotation ผ่าน replaced_by
model RefreshToken {
  tokenId     Int       @id @default(autoincrement()) @map("token_id")
  userId      Int       @map("user_id")
  tokenHash   String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  /// token ใหม่ที่มาแทนตอน rotation — ถ้ามีคนใช้ token ที่ revoked แล้ว = ถูกขโมย ให้เพิกถอนทั้งหมดของผู้ใช้คนนั้น
  replacedBy  Int?      @map("replaced_by")
  deviceLabel String?   @map("device_label") @db.VarChar(100)
  createdAt   DateTime  @default(now()) @map("created_at")

  user            User           @relation(fields: [userId], references: [userId], onDelete: Cascade)
  replacedByToken RefreshToken?  @relation("TokenRotation", fields: [replacedBy], references: [tokenId], onDelete: NoAction, onUpdate: NoAction)
  replacesToken   RefreshToken[] @relation("TokenRotation")

  /// ตรวจ token ทุก request
  @@index([userId, revokedAt])
}

// ============================================================
//  กลุ่มการแข่งขัน
// ============================================================

/// ผลแข่ง 1v1 (ห้องแข่งขัน + ห้องสร้างเอง) — ห้องฝึกซ้อมไม่มีแถวในตารางนี้
/// เขียนแถวก็ต่อเมื่อแมตช์จบแล้ว: winner_id = NULL หมายถึง "เสมอ" ไม่ใช่ "ยังไม่จบ" (ADR-007)
model Match {
  matchId   Int      @id @default(autoincrement()) @map("match_id")
  roomType  RoomType @map("room_type")
  cubeType  CubeType @map("cube_type")
  /// ผู้เล่นที่เข้าคิว/สร้างห้องก่อน — ต้องคงลำดับนี้เสมอ
  player1Id Int      @map("player1_id")
  player2Id Int      @map("player2_id")
  scramble  String   @db.VarChar(255)
  /// รหัสห้อง (เฉพาะ room_type = CUSTOM)
  roomCode  String?  @map("room_code") @db.VarChar(6)

  /// วินาที — NULL = DNF/DNS เสมอ (ห้ามใช้ 0 แทน) ดู player1_result ควบคู่
  player1Time      Decimal?    @map("player1_time") @db.Decimal(6, 2)
  player2Time      Decimal?    @map("player2_time") @db.Decimal(6, 2)
  player1Result    SolveResult @map("player1_result")
  player2Result    SolveResult @map("player2_result")
  player1MoveCount Int?        @map("player1_move_count")
  player2MoveCount Int?        @map("player2_move_count")

  /// NULL ทั้ง 4 คอลัมน์เมื่อ room_type = CUSTOM (ไม่ปรับคะแนน) — elo_after คำนวณจาก before + change
  player1EloBefore Int? @map("player1_elo_before")
  player1EloChange Int? @map("player1_elo_change")
  player2EloBefore Int? @map("player2_elo_before")
  player2EloChange Int? @map("player2_elo_change")

  winnerId       Int?      @map("winner_id")
  /// จำนวนผู้ชมสูงสุดระหว่างแมตช์
  spectatorCount Int       @default(0) @map("spectator_count")
  startedAt      DateTime  @default(now()) @map("started_at")
  finishedAt     DateTime? @map("finished_at")

  player1 User  @relation("MatchPlayer1", fields: [player1Id], references: [userId], onDelete: Restrict)
  player2 User  @relation("MatchPlayer2", fields: [player2Id], references: [userId], onDelete: Restrict)
  winner  User? @relation("MatchWinner", fields: [winnerId], references: [userId], onDelete: Restrict)

  reports Report[]
  flags   MatchFlag[]

  /// weekly leaderboard
  @@index([cubeType, startedAt])
  /// ประวัติการแข่งของผู้ใช้
  @@index([player1Id, startedAt])
  @@index([player2Id, startedAt])
  /// ค้นหาห้องด้วยรหัส
  @@index([roomCode])
}

/// คะแนน Elo แยกตามประเภทรูบิค — ผู้ใช้ 1 คนมี 4 แถว (seed 1000 ตอนสมัคร ในทรานแซกชันเดียวกัน)
/// matches_played / wins / losses / draws / best_time เป็นข้อมูลซ้ำซ้อน (ADR-014)
/// → ต้องอัปเดตในทรานแซกชันเดียวกับที่บันทึกผลแมตช์เสมอ ซ่อมด้วย scripts/recalculate-ratings.ts
model Rating {
  userId        Int      @map("user_id")
  cubeType      CubeType @map("cube_type")
  eloRating     Int      @default(1000) @map("elo_rating")
  matchesPlayed Int      @default(0) @map("matches_played")
  wins          Int      @default(0)
  losses        Int      @default(0)
  draws         Int      @default(0)
  /// วินาที — นับเฉพาะแมตช์ที่บันทึก DB (ห้องฝึกซ้อมไม่นับ)
  bestTime      Decimal? @map("best_time") @db.Decimal(6, 2)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([userId, cubeType])
  /// leaderboard หลัก
  @@index([cubeType, eloRating(sort: Desc)])
  /// leaderboard เรียงตามเวลา
  @@index([cubeType, bestTime(sort: Asc)])
}

/// แมตช์ผู้เล่นหลายคน (3–4 คน) — ตารางแยกทั้งชุด ไม่ได้ขยาย Match ด้วย player3_id
model MultiplayerMatch {
  multiplayerMatchId Int       @id @default(autoincrement()) @map("multiplayer_match_id")
  cubeType           CubeType  @map("cube_type")
  roomMode           RoomMode  @map("room_mode")
  scramble           String    @db.VarChar(255)
  /// รหัสห้อง (เฉพาะ room_mode = CUSTOM)
  roomCode           String?   @map("room_code") @db.VarChar(6)
  /// 3 หรือ 4
  playerCount        Int       @map("player_count")
  startedAt          DateTime  @default(now()) @map("started_at")
  finishedAt         DateTime? @map("finished_at")

  participants MultiplayerMatchParticipant[]
  reports      Report[]
  flags        MatchFlag[]

  /// weekly leaderboard
  @@index([cubeType, startedAt])
  @@index([roomCode])
}

/// ผู้เข้าร่วมแมตช์หลายคน — elo_change / elo_before มีค่าเฉพาะ room_mode = AUTO (Pairwise Elo)
model MultiplayerMatchParticipant {
  multiplayerMatchId Int         @map("multiplayer_match_id")
  userId             Int         @map("user_id")
  /// วินาที — NULL = DNF/DNS เสมอ
  solveTime          Decimal?    @map("solve_time") @db.Decimal(6, 2)
  result             SolveResult
  /// อันดับในห้องนี้ ตาม game-rules.md ข้อ 7
  rankNo             Int         @map("rank_no")
  moveCount          Int?        @map("move_count")
  eloBefore          Int?        @map("elo_before")
  eloChange          Int?        @map("elo_change")

  match MultiplayerMatch @relation(fields: [multiplayerMatchId], references: [multiplayerMatchId], onDelete: Cascade)
  user  User             @relation(fields: [userId], references: [userId], onDelete: Restrict)

  @@id([multiplayerMatchId, userId])
  /// ประวัติการแข่งของผู้ใช้
  @@index([userId])
}

// ============================================================
//  กลุ่มเนื้อหา + ดูแลระบบ
// ============================================================

/// รายงานผู้เล่น — รายงานตัวเองไม่ได้ / รายงานคนเดิมซ้ำได้ไม่เกิน 1 ครั้งต่อ 24 ชั่วโมง
/// CHECK: ตั้ง match_id หรือ multiplayer_match_id ได้อย่างมากช่องเดียว (raw SQL ใน migration)
model Report {
  reportId           Int           @id @default(autoincrement()) @map("report_id")
  reporterId         Int           @map("reporter_id")
  reportedId         Int           @map("reported_id")
  reason             String        @db.Text
  reportStatus       ReportStatus  @default(PENDING) @map("report_status")
  matchId            Int?          @map("match_id")
  multiplayerMatchId Int?          @map("multiplayer_match_id")
  reviewedBy         Int?          @map("reviewed_by")
  reviewedAt         DateTime?     @map("reviewed_at")
  /// แยกจาก report_status — RESOLVED บอกแค่ว่าตรวจแล้ว ไม่บอกว่าตัดสินยังไง
  actionTaken        ReportAction? @map("action_taken")
  adminNote          String?       @map("admin_note") @db.Text
  createdAt          DateTime      @default(now()) @map("created_at")

  reporter         User              @relation("ReportReporter", fields: [reporterId], references: [userId], onDelete: Restrict)
  reported         User              @relation("ReportReported", fields: [reportedId], references: [userId], onDelete: Restrict)
  reviewer         User?             @relation("ReportReviewer", fields: [reviewedBy], references: [userId], onDelete: Restrict)
  match            Match?            @relation(fields: [matchId], references: [matchId], onDelete: Restrict)
  multiplayerMatch MultiplayerMatch? @relation(fields: [multiplayerMatchId], references: [multiplayerMatchId], onDelete: Restrict)

  /// หน้ารายการรายงานของแอดมิน
  @@index([reportStatus, createdAt])
  /// กันรายงานซ้ำภายใน 24 ชั่วโมง
  @@index([reporterId, reportedId, createdAt])
}

/// ข่าวสาร/กิจกรรม — author_id ใช้ RESTRICT: ห้ามลบบัญชีแอดมินที่ยังมีข่าวค้างอยู่
model News {
  newsId    Int      @id @default(autoincrement()) @map("news_id")
  title     String   @db.VarChar(150)
  content   String   @db.Text
  image     String?  @db.VarChar(255)
  authorId  Int      @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author User @relation(fields: [authorId], references: [userId], onDelete: Restrict)

  /// หน้ารายการข่าว
  @@index([createdAt(sort: Desc)])
}

/// ➕ แมตช์ที่ระบบสงสัยว่าโกง — ผลผิดปกติให้ flag ไว้ตรวจ ไม่ auto-reject
/// CHECK: ต้องมี match_id หรือ multiplayer_match_id อย่างใดอย่างหนึ่งเท่านั้น (raw SQL ใน migration)
model MatchFlag {
  flagId             Int          @id @default(autoincrement()) @map("flag_id")
  matchId            Int?         @map("match_id")
  multiplayerMatchId Int?         @map("multiplayer_match_id")
  userId             Int          @map("user_id")
  flagReason         FlagReason   @map("flag_reason")
  /// { "measured": 2.14, "threshold": 3.50, "metric": "solve_time_seconds", "cubeType": "3x3x3" }
  detail             Json         @db.JsonB
  /// [ { "seq": 1, "move": "R", "ms": 342 }, ... ] — job ล้างเป็น NULL หลัง 90 วัน
  moveLog            Json?        @map("move_log") @db.JsonB
  reviewedBy         Int?         @map("reviewed_by")
  reviewedAt         DateTime?    @map("reviewed_at")
  verdict            FlagVerdict?
  createdAt          DateTime     @default(now()) @map("created_at")

  match            Match?            @relation(fields: [matchId], references: [matchId], onDelete: Restrict)
  multiplayerMatch MultiplayerMatch? @relation(fields: [multiplayerMatchId], references: [multiplayerMatchId], onDelete: Restrict)
  user             User              @relation("MatchFlagUser", fields: [userId], references: [userId], onDelete: Restrict)
  reviewer         User?             @relation("MatchFlagReviewer", fields: [reviewedBy], references: [userId], onDelete: Restrict)

  /// หน้าแมตช์ที่ถูก flag
  @@index([verdict, createdAt])
  @@index([userId, createdAt])
}

/// ➕ log การกระทำของแอดมิน — ทุก endpoint ใต้ /admin ที่เปลี่ยนข้อมูลต้องเขียนแถวนี้ในทรานแซกชันเดียวกัน
model AdminAuditLog {
  logId        Int      @id @default(autoincrement()) @map("log_id")
  adminId      Int      @map("admin_id")
  /// suspend_user | unsuspend_user | edit_rating | resolve_report | review_flag | create_news | update_news | delete_news
  action       String   @db.VarChar(50)
  targetUserId Int?     @map("target_user_id")
  /// { "cubeType": "3x3x3", "before": 1210, "after": 1200, "note": "..." }
  detail       Json?    @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at")

  admin      User  @relation("AuditAdmin", fields: [adminId], references: [userId], onDelete: Restrict)
  targetUser User? @relation("AuditTarget", fields: [targetUserId], references: [userId], onDelete: Restrict)

  @@index([adminId, createdAt])
  @@index([targetUserId, createdAt])
}
